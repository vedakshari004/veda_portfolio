<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- Root container with id="main" for window-inset padding -->
    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Toolbar with id="toolbar" for title & back button -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorPrimary"
            android:elevation="4dp"
            android:padding="16dp"
            android:title="Projects"
            android:titleTextColor="#FFFFFF" />

        <!-- Page Title -->
        <TextView
            android:id="@+id/sectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PROJECTS"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp" />

        <!-- Project 1 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Classroom Database Management System (DBMS)"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginBottom="4dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Platform: SQL Plus"
            android:textSize="16sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Description: Developed a database management system to automate classroom, faculty, and student. The system streamlined scheduling, attendance, and exams, enhancing operational efficiency."
            android:textSize="16sp"
            android:layout_marginTop="4dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Scope: In future this can be made into a very interactive way so that it would be easy to use and make the data redundant."
            android:textSize="16sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp" />

        <!-- Project 2 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="API for Medical Suggestions"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginBottom="4dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Platform: React"
            android:textSize="16sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Description: Developed an API to evaluate the price of tablets by applying the offers that particular drug has and also used HTML and CSS to enhance the web application."
            android:textSize="16sp"
            android:layout_marginTop="4dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Scope: In future this can be very helpful as the economy is developing and products and drugs are becoming more expensive."
            android:textSize="16sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp" />

        <!-- Project 3: Internship -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Internship Project – Uncalled Innovators (React Intern)"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginBottom="4dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Description: During my internship at Uncalled Innovators, I enhanced my skills in React by applying theoretical knowledge to real-world projects. I worked on various tasks which deepened my understanding of how APIs are built and used with React."
            android:textSize="16sp"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</ScrollView>
